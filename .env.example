# API Keys
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEWS_API_KEY=your_newsapi_key_here  # Get from https://newsapi.org/

# YouTube API Credentials
# Download client_secrets.json from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Default Settings
DEFAULT_VIDEO_MODEL=veo  # Options: veo, sora
DEFAULT_LANGUAGE=en  # Language code for audio
DEFAULT_VOICE_ID=  # ElevenLabs voice ID (optional, will use default)

# Video Settings
VIDEO_RESOLUTION=1920x1080
VIDEO_FPS=30
MAX_VIDEO_DURATION=60  # seconds

# Output Settings
OUTPUT_DIR=./output
TEMP_DIR=./temp

# News Settings
NEWS_COUNTRY=us  # Country code for news (us, gb, ca, etc.)
NEWS_CATEGORY=  # Category (business, technology, sports, etc.) - leave empty for all
NEWS_MAX_ARTICLES=5  # Maximum articles to fetch
NEWS_VIDEO_DURATION=10  # Duration per news video in seconds
